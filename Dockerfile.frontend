# Build stage
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY web/frontend/package*.json ./
RUN npm ci

# Copy source
COPY web/frontend/ ./

# Build
RUN npm run build

# Runtime stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config
COPY web/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
